# ZalSports - Variables d'environnement
# Copier ce fichier en .env.local pour le développement

# Base de données SQLite
DATABASE_URL=file:./db/zalsports.db

# Identifiants admin (changer en production !)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=zalsports2024

# Secret pour les tokens (générer avec: openssl rand -hex 32)
ADMIN_SECRET=change-me-to-a-random-string
